{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: main.py with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": ["-i", "./data/input/input_2.srt", "-o", "./data/output/output_2_gpt-4o-mini.srt", "-to", "Chinese"]
    },
    {
      "name": "Python: Run unittest for test_file_handler.py",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["tests/test_file_handler.py"],
      "console": "integratedTerminal"
    }
  ]
}